{
  "$schema": "../../frontend/node_modules/wrangler/config-schema.json",
  "name": "sty-server",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-04-25",
  "compatibility_flags": ["nodejs_compat_v2"],
  "build": {
    "command": "worker-build --release"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "AVE_ISSUER": "https://aveid.net",
    "AVE_CLIENT_ID": "app_813ac5533bb87d939f328d76b5a1dca8"
  },
  "r2_buckets": [
    {
      "binding": "STY_OBJECTS",
      "bucket_name": "sty-objects"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PROJECT_COORDINATOR",
        "class_name": "ProjectCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ProjectCoordinator"]
    }
  ]
}
