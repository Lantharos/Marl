{
  "$schema": "../frontend/node_modules/wrangler/config-schema.json",
  "name": "sty-server",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-04-25",
  "compatibility_flags": ["nodejs_compat_v2"],
  "build": {
    "command": "worker-build --release",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
  "vars": {
    "AVE_ISSUER": "https://aveid.net",
    "AVE_CLIENT_ID": "app_813ac5533bb87d939f328d76b5a1dca8",
    "STY_FRONTEND_ORIGIN": "https://sty.sh",
    "STY_ALLOWED_ORIGINS": "https://sty.sh,http://localhost:5173,http://127.0.0.1:5173",
  },
  "r2_buckets": [
    {
      "binding": "STY_OBJECTS",
      "bucket_name": "sty-objects",
    },
  ],
  "d1_databases": [
    {
      "binding": "STY_DB",
      "database_name": "sty",
      "database_id": "411f1af8-485e-43ce-9313-d56307bf71d2",
    },
  ],
  "routes": [
    {
      "pattern": "sty.sh/api/*",
      "zone_name": "sty.sh",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "STY_CI_RUNNER_POOL",
        "class_name": "CiRunnerPool",
      },
    ],
  },
  "migrations": [
    {
      "tag": "ci-runner-pool-v1",
      "new_sqlite_classes": ["CiRunnerPool"],
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "STY_WEBHOOK_QUEUE",
        "queue": "sty-webhooks",
      },
      {
        "binding": "STY_CI_QUEUE",
        "queue": "sty-ci",
      },
    ],
    "consumers": [
      {
        "queue": "sty-webhooks",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 60,
        "dead_letter_queue": "sty-webhooks-dlq",
      },
      {
        "queue": "sty-ci",
        "max_batch_size": 20,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 30,
        "dead_letter_queue": "sty-ci-dlq",
      },
    ],
  },
}
