{
  "name": "sty",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter './apps/*' dev",
    "dev:web": "bun --cwd apps/web dev",
    "dev:api": "bun --cwd apps/api dev",
    "check": "bun run --filter '*' check",
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test && cargo test --workspace"
  }
}
