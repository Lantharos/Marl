{
  "name": "sty",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:plan": "bun scripts/dev.ts --plan",
    "dev:web": "bun scripts/dev.ts web",
    "dev:api": "bun scripts/dev.ts api",
    "dev:git": "bun scripts/dev.ts git",
    "qualify": "bun scripts/qualify.ts",
    "check": "bun run --filter '*' check",
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test && cargo test --workspace"
  }
}
