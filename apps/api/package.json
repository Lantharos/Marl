{
  "name": "@marl/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 42618 --inspector-port 42620 --test-scheduled",
    "types": "wrangler types worker-configuration.d.ts --include-runtime=false --strict-vars=false --env-interface CloudflareBindings",
    "types:check": "bun run types --check",
    "check": "bun run types:check && tsc --noEmit",
    "test": "bun test",
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "wrangler d1 migrations apply marl --local"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "@marl/contracts": "workspace:*",
    "@types/bun": "^1.4.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "wrangler": "^4.149.0"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.7",
    "@marl/markdown": "workspace:*",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "pult": "npm:@lantharos/pult@^0.8.0",
    "valibot": "^1.5.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
