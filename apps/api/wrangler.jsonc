{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sty-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "vars": {
    "ENVIRONMENT": "development",
    "GIT_GATEWAY_URL": "http://127.0.0.1:8788",
    "GIT_PUBLIC_URL": "http://127.0.0.1:8788"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sty",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "OBJECTS",
      "bucket_name": "sty-objects"
    }
  ]
}
