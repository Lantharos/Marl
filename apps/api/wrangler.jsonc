{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "marl-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "marl.sh/api/*",
      "zone_name": "marl.sh"
    },
    {
      "pattern": "marl.sh/health",
      "zone_name": "marl.sh"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_URL": "https://marl.sh",
    "GIT_PUBLIC_URL": "https://git.marl.sh",
    "EMAIL_FROM": "noreply@marl.sh"
  },
  "secrets": {
    "required": ["AUTH_SECRET", "SECRET_ENCRYPTION_KEY", "GIT_GATEWAY_TOKEN"]
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@marl.sh"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "marl",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "OBJECTS",
      "bucket_name": "marl-objects"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 600, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PULL_ROOMS",
        "class_name": "PullRoom"
      },
      {
        "name": "RUN_ROOMS",
        "class_name": "RunRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "pull-rooms-v1",
      "new_sqlite_classes": ["PullRoom"]
    },
    {
      "tag": "run-rooms-v1",
      "new_sqlite_classes": ["RunRoom"]
    }
  ]
}
