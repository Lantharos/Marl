    "reports": {
      "source": "src/backoffice/reports.pult.ts:34",
      "label": "Reports",
      "icon": "flag",
      "resource": null,
      "layout": "list",
      "states": [
        "open",
        "actioned",
        "dismissed"
      ],
      "closed": [
        "actioned",
        "dismissed"
      ],
      "reopen": [
        "actioned",
        "dismissed"
      ],
      "data": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "repository",
                  "issue",
                  "pull",
                  "issue_comment",
                  "pull_comment",
                  "review_comment",
                  "user"
                ]
              },
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "excerpt": {
                "type": "string",
                "maxLength": 5000
              }
            },
            "required": [
              "type",
              "id",
              "title",
              "url",
              "excerpt"
            ]
          },
          "reason": {
            "type": "string",
            "enum": [
              "spam",
              "malware",
              "harassment",
              "copyright",
              "private_information",
              "illegal",
              "other"
            ]
          },
          "details": {
            "type": "string",
            "maxLength": 5000
          },
          "reporter": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "handle": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "handle"
            ]
          },
          "author": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "handle": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "handle"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "repository": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "name"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "subject",
          "reason",
          "details",
          "reporter",
          "author",
          "repository"
        ]
      },
      "columns": [
        "title",
        "state",
        "occurrences",
        "data.reason",
        "lastSeen"
      ],
      "intake": null,
      "triage": {
        "instructions": "People report content on Marl, a code hosting platform, for breaking the Acceptable Use Policy. Judge the reported content in `subject.excerpt`, not the reporter’s description of it. Code, security research and strong technical disagreement are allowed.",
        "questions": {
          "violates": {
            "type": "noul",
            "prompt": "Does `subject.excerpt` break the Acceptable Use Policy: spam, malware, phishing, harassment, hate, someone’s private information or illegal content?"
          },
          "category": {
            "type": "choice",
            "prompt": "What, if anything, is wrong with `subject.excerpt`?",
            "options": {
              "spam": "Advertising, SEO links, scams or bulk automated content",
              "malware": "Code or links meant to harm people or systems",
              "abuse": "Harassment, threats or hate aimed at people",
              "privacy": "Personal data or credentials that belong to someone else",
              "fine": "Nothing wrong with it"
            }
          }
        },
        "rules": [
          {
            "name": "Dismiss reports on harmless content",
            "live": false,
            "then": [
              {
                "type": "state",
                "state": "dismissed"
              }
            ]
          },
          {
            "name": "Tag obvious spam",
            "live": false,
            "then": [
              {
                "type": "tag",
                "tag": "spam"
              }
            ]
          }
        ]
      },
      "reply": false,
      "hooks": {
        "state": false
      },
      "sla": {
        "open": 86400000
      }
    }
