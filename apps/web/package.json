{
  "name": "@marl/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 42617 --strictPort",
    "types": "wrangler types worker-configuration.d.ts --include-runtime=false --strict-vars=false --env-interface CloudflareBindings",
    "types:check": "bun run types --check",
    "check": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
    "build": "vite build && bun run types:check && wrangler deploy --dry-run --outdir dist",
    "deploy": "vite build && wrangler deploy",
    "preview": "vite build && wrangler dev",
    "test": "bun test src/lib"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260920.1",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/bun": "^1.4.2",
    "@types/d3-geo": "^3.1.1",
    "@types/katex": "^0.16.8",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.1",
    "@types/three": "^0.186.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "wrangler": "^4.135.0"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.5",
    "@marl/contracts": "workspace:*",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "better-auth": "^1.7.5",
    "d3-geo": "^3.1.1",
    "gemoji": "^8.1.0",
    "github-slugger": "^2.0.0",
    "katex": "^0.18.7",
    "lucide-svelte": "^1.0.1",
    "marked": "^18.0.13",
    "marked-footnote": "^1.4.0",
    "mermaid": "^12.0.0",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.17.7",
    "shiki": "^4.4.3",
    "three": "^0.186.0",
    "topojson-client": "^3.1.0"
  }
}
